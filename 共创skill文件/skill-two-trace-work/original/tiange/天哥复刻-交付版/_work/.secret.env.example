# 把本文件复制成同目录的 .secret.env，填上你自己的 key（.secret.env 已 .gitignore，不进包不外传）
#   cp _work/.secret.env.example _work/.secret.env
# 这个文件就是“总开关”：两条后端的 key、模型、分辨率都在这里设，不用碰命令行/环境变量。
#
# 默认按脸分流：
#   有人脸镜 → APIMart（脸更稳）        → 需要 APIMART_TOKEN
#   无人脸镜（产品/场景）→ 火山方舟 Mini 资源包（最省） → 需要 ARK_API_KEY
# 两条都填，混合分流自动生效；只填一条就只能跑对应那类镜（缺哪条 gen_video 会提示）。

APIMART_TOKEN=
ARK_API_KEY=

# —— 可选高级开关（一般不用动）——
# FK_FACE_ROUTE=ark       # 有脸镜也改用火山方舟 Fast（你的 key 也能调 Fast）；默认 apimart
# FK_ROUTE=ark            # 整片强制走一条（ark 或 apimart），覆盖按脸分流
# FK_MODEL_MINI=          # 万一 Mini 官方 model id 跟默认不符，填正确 id 覆盖（先跑 verify_mini 验）
# FK_RESOLUTION=480p      # 整片强制某分辨率（省钱草稿）；不填则人物镜720p、其余480p
# FK_AI_LABEL=1           # 出片叠“AI生成”角标（真人/换脸成片发国内平台建议开）
