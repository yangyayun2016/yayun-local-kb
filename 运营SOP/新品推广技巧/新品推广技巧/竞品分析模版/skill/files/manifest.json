{
  "manifest_version": 3,
  "name": "Geo Consistency (Local)",
  "version": "1.0.0",
  "description": "Keep browser-visible location/timezone/language consistent with the current egress IP. Local-only, no telemetry.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://ipapi.co/*",
    "https://ipwho.is/*",
    "https://ipinfo.io/*",
    "https://overpass-api.de/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Geo Consistency",
    "default_popup": "popup/popup.html"
  }
}
