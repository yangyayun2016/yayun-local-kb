# ===== 数据库（默认SQLite，生产切PostgreSQL） =====
# TIANJI_DATABASE_URL=postgresql+psycopg2://tianji:password@localhost:5432/tianji

# ===== AI 层（配置后日报/诊断走Claude，否则走规则引擎） =====
# ANTHROPIC_API_KEY=sk-ant-xxx
# TIANJI_MODEL=claude-sonnet-4-6

# ===== MCP 数据服务层 =====
# TIANJI_MCP_SELLERSPRITE_URL=https://mcp.sellersprite.com/mcp
# TIANJI_MCP_SELLERSPRITE_TOKEN=xxx
# TIANJI_MCP_SIF_URL=https://mcp.sif.com/mcp
# TIANJI_MCP_SIF_TOKEN=xxx
# TIANJI_MCP_SORFTIME_URL=https://mcp.sorftime.com
# TIANJI_MCP_SORFTIME_TOKEN=xxx

# ===== 飞书推送 =====
# TIANJI_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ===== RPA（1=只演练不执行，0=真实执行） =====
TIANJI_RPA_DRY_RUN=1
